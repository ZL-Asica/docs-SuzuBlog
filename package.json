{
  "name": "docs-suzublog",
  "version": "1.14.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "docs:dev": "vitepress dev docs --port 4000",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4000",
    "lint": "eslint . --ignore-pattern docs/.vitepress/cache",
    "lint:fix": "eslint --fix . --ignore-pattern docs/.vitepress/cache",
    "commitlint": "commitlint --edit",
    "postinstall": "husky || true"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3",
    "vitepress": "2.0.0-alpha.21",
    "vue": "^3.5.44"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue,css,json}": [
      "eslint --fix"
    ]
  }
}
